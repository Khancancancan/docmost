@@ -0,0 +1,100 @@
+# SPDX-FileCopyrightText: 2026 The HedgeDoc authors (see AUTHORS file)
+# SPDX-License-Identifier: AGPL-3.0-only
+#
+# Pipeline for the /hedgedoc subpath build.
+#
+# Required GitLab CI/CD variables (Settings -> CI/CD -> Variables):
+#   KUBE_CONFIG  kubeconfig of a service account that can manage the
+#                "hedgedoc" namespace on the work cluster
+#   HD_BASE_URL  external URL incl. subpath, e.g. https://notes.example.com/hedgedoc
+#
+# The GitLab built-in variables CI_REGISTRY / CI_REGISTRY_IMAGE /
+# CI_REGISTRY_USER / CI_REGISTRY_PASSWORD are used automatically.
+# Docker-in-Docker jobs require a runner with the "privileged" mode enabled.
+
+stages:
+  - build
+  - deploy
+
+variables:
+  BASE_PATH: "/hedgedoc"
+  DEPLOY_NAMESPACE: "hedgedoc"
+  DOCKER_TLS_CERTDIR: ""
+  DOCKER_HOST: tcp://docker:2375
+  DOCKER_BUILDKIT: "1"
+
+# ---------------------------------------------------------------------------
+# Build the two application images from this repository. The frontend build
+# bakes in NEXT_PUBLIC_BASE_PATH=${BASE_PATH}.
+# ---------------------------------------------------------------------------
+
+build:backend:
+  stage: build
+  image: docker:27
+  services:
+    - docker:27-dind
+  rules:
+    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
+  before_script:
+    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" "$CI_REGISTRY"
+  script:
+    - docker build
+      -f backend/docker/Dockerfile
+      -t "$CI_REGISTRY_IMAGE/backend:$CI_COMMIT_SHA"
+      -t "$CI_REGISTRY_IMAGE/backend:latest"
+      .
+    - docker push "$CI_REGISTRY_IMAGE/backend:$CI_COMMIT_SHA"
+    - docker push "$CI_REGISTRY_IMAGE/backend:latest"
+
+build:frontend:
+  stage: build
+  image: docker:27
+  services:
+    - docker:27-dind
+  rules:
+    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
+  before_script:
+    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" "$CI_REGISTRY"
+  script:
+    - docker build
+      --build-arg NEXT_PUBLIC_BASE_PATH=$BASE_PATH
+      -f frontend/docker/Dockerfile
+      -t "$CI_REGISTRY_IMAGE/frontend:$CI_COMMIT_SHA"
+      -t "$CI_REGISTRY_IMAGE/frontend:latest"
+      .
+    - docker push "$CI_REGISTRY_IMAGE/frontend:$CI_COMMIT_SHA"
+    - docker push "$CI_REGISTRY_IMAGE/frontend:latest"
+
+# ---------------------------------------------------------------------------
+# Deploy manifests and roll the new images out.
+# Manifests live in deploy/k8s (namespace, configmap, secret, postgres,
+# backend, frontend, caddy proxy, ingress).
+# ---------------------------------------------------------------------------
+
+deploy:production:
+  stage: deploy
+  image: bitnami/kubectl:1.31
+  dependencies: []
+  rules:
+    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
+  before_script:
+    - test -n "$KUBE_CONFIG" || (echo "KUBE_CONFIG variable is required" && exit 1)
+    - test -n "$HD_BASE_URL" || (echo "HD_BASE_URL variable is required" && exit 1)
+    - mkdir -p "$HOME/.kube"
+    - echo "$KUBE_CONFIG" > "$HOME/.kube/config"
+  script:
+    - kubectl apply -f deploy/k8s
+    # Point the application to the real external URL (checked-in default is
+    # the local minikube URL). Other ConfigMap keys stay untouched.
+    - kubectl -n "$DEPLOY_NAMESPACE" patch configmap hedgedoc-env --type merge
+      -p "{\"data\":{\"HD_BASE_URL\":\"$HD_BASE_URL\"}}"
+    # Roll out the freshly built images.
+    - kubectl -n "$DEPLOY_NAMESPACE" set image deployment/backend
+      backend="$CI_REGISTRY_IMAGE/backend:$CI_COMMIT_SHA"
+    - kubectl -n "$DEPLOY_NAMESPACE" set image deployment/frontend
+      frontend="$CI_REGISTRY_IMAGE/frontend:$CI_COMMIT_SHA"
+    - kubectl -n "$DEPLOY_NAMESPACE" rollout status deployment/db --timeout=180s
+    - kubectl -n "$DEPLOY_NAMESPACE" rollout status deployment/backend --timeout=180s
+    - kubectl -n "$DEPLOY_NAMESPACE" rollout status deployment/frontend --timeout=180s
+    - kubectl -n "$DEPLOY_NAMESPACE" rollout restart deployment/proxy
+    - kubectl -n "$DEPLOY_NAMESPACE" rollout status deployment/proxy --timeout=180s
