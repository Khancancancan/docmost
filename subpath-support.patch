+# SPDX-FileCopyrightText: 2026 The HedgeDoc authors (see AUTHORS file)
+# SPDX-License-Identifier: AGPL-3.0-only
+#
+# WARNING: these values are for local/minikube testing only.
+# On the work cluster replace them, e.g. with Sealed-Secret / External-Secrets
+# or at least `kubectl create secret generic hedgedoc-secret --from-literal=...`.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: hedgedoc-secret
+  namespace: hedgedoc
+type: Opaque
+stringData:
+  HD_DATABASE_PASSWORD: "hedgedoc"
+  # At least 32 characters!
+  HD_AUTH_SESSION_SECRET: "local-minikube-session-secret-change-me-000001"
+  POSTGRES_PASSWORD: "hedgedoc"
diff --git a/deploy/k8s/10-postgres.yaml b/deploy/k8s/10-postgres.yaml
new file mode 100644
index 000000000..db351340c
--- /dev/null
+++ b/deploy/k8s/10-postgres.yaml
@@ -0,0 +1,87 @@
+# SPDX-FileCopyrightText: 2026 The HedgeDoc authors (see AUTHORS file)
+# SPDX-License-Identifier: AGPL-3.0-only
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: db
+  namespace: hedgedoc
+  labels:
+    app: hedgedoc-db
+spec:
+  replicas: 1
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: hedgedoc-db
+  template:
+    metadata:
+      labels:
+        app: hedgedoc-db
+    spec:
+      containers:
+        - name: postgres
+          image: postgres:15
+          ports:
+            - containerPort: 5432
+          env:
+            - name: POSTGRES_USER
+              value: hedgedoc
+            - name: POSTGRES_DB
+              value: hedgedoc
+            - name: POSTGRES_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: hedgedoc-secret
+                  key: POSTGRES_PASSWORD
+          volumeMounts:
+            - name: db-data
+              mountPath: /var/lib/postgresql/data
+          # NOTE: kubernetes exec probes run the array directly - there is no
+          # shell, so docker-compose's "CMD-SHELL" form does NOT work here.
+          readinessProbe:
+            exec:
+              command: ["pg_isready", "-U", "hedgedoc", "-d", "hedgedoc"]
+            initialDelaySeconds: 5
+            periodSeconds: 5
+          livenessProbe:
+            exec:
+              command: ["pg_isready", "-U", "hedgedoc", "-d", "hedgedoc"]
+            initialDelaySeconds: 15
+            periodSeconds: 15
+          resources:
+            requests:
+              cpu: "50m"
+              memory: "128Mi"
+            limits:
+              cpu: "500m"
+              memory: "512Mi"
+      volumes:
+        - name: db-data
+          persistentVolumeClaim:
+            claimName: hedgedoc-db-data
+---
+apiVersion: v1
+kind: Service
+metadata:
