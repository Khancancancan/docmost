+# SPDX-FileCopyrightText: 2026 The HedgeDoc authors (see AUTHORS file)
+# SPDX-License-Identifier: AGPL-3.0-only
+#
+# Caddy is the in-cluster entry point. It strips /hedgedoc for backend
+# requests and keeps it for the Next.js frontend. The ingress only routes
+# the /hedgedoc path to this service (no rewrite there).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: proxy
+  namespace: hedgedoc
+  labels:
+    app: hedgedoc-proxy
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: hedgedoc-proxy
+  template:
+    metadata:
+      labels:
+        app: hedgedoc-proxy
+    spec:
+      containers:
+        - name: caddy
+          image: caddy:2
+          ports:
+            - containerPort: 80
+          volumeMounts:
+            - name: caddyfile
+              mountPath: /etc/caddy/Caddyfile
+              subPath: Caddyfile
+              readOnly: true
+          readinessProbe:
+            tcpSocket:
+              port: 80
+            initialDelaySeconds: 3
+            periodSeconds: 10
+          resources:
+            requests:
+              cpu: "25m"
+              memory: "32Mi"
+            limits:
+              cpu: "250m"
+              memory: "128Mi"
+      volumes:
+        - name: caddyfile
+          configMap:
+            name: hedgedoc-proxy-config
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: proxy
+  namespace: hedgedoc
+spec:
+  selector:
+    app: hedgedoc-proxy
+  ports:
+    - name: http
+      port: 80
+      targetPort: 80
+      protocol: TCP
diff --git a/deploy/k8s/50-ingress.yaml b/deploy/k8s/50-ingress.yaml
new file mode 100644
index 000000000..72a5e8e2c
--- /dev/null
+++ b/deploy/k8s/50-ingress.yaml
@@ -0,0 +1,39 @@
+# SPDX-FileCopyrightText: 2026 The HedgeDoc authors (see AUTHORS file)
+# SPDX-License-Identifier: AGPL-3.0-only
+#
+# Requires the ingress-nginx controller:
+#   minikube addons enable ingress
+#
+# IMPORTANT: there is deliberately NO rewrite-target annotation. The whole
+# /hedgedoc path is passed to Caddy unchanged; stripping happens in Caddy
+# for the backend routes only.
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: hedgedoc
+  namespace: hedgedoc
+  annotations:
+    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
+    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
+    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
+spec:
+  ingressClassName: nginx
+  rules:
+    # No host restriction so http://localhost:20866 works during local tests.
+    # Add "- host: notes.example.com" for the work cluster if desired.
+    - http:
+        paths:
+          - path: /hedgedoc
+            pathType: Exact
+            backend:
+              service:
+                name: proxy
+                port:
+                  number: 80
+          - path: /hedgedoc/
+            pathType: Prefix
+            backend:
+              service:
+                name: proxy
+                port:
+                  number: 80
