+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: docmost-storage
+  namespace: docmost
+spec:
+  accessModes:
+    - ReadWriteOnce
+  resources:
+    requests:
+      storage: 2Gi
diff --git a/deploy/k8s/40-proxy.yaml b/deploy/k8s/40-proxy.yaml
new file mode 100644
index 00000000..18c2ef7b
--- /dev/null
+++ b/deploy/k8s/40-proxy.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: MIT
+#
+# Caddy is the in-cluster entry point. It strips /docmost for every request
+# (Docmost is a single app) and redirects bare / to the subpath. The ingress
+# only routes the /docmost path to this service (no rewrite there).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: proxy
+  namespace: docmost
+  labels:
+    app: docmost-proxy
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: docmost-proxy
+  template:
+    metadata:
+      labels:
+        app: docmost-proxy
+    spec:
+      containers:
+        - name: caddy
+          image: caddy:2
+          ports:
+            - containerPort: 80
+          volumeMounts:
+            - name: caddyfile
+              mountPath: /etc/caddy/Caddyfile
+              subPath: Caddyfile
+              readOnly: true
+          readinessProbe:
+            tcpSocket:
+              port: 80
+            initialDelaySeconds: 3
+            periodSeconds: 10
+          resources:
+            requests:
+              cpu: "25m"
+              memory: "32Mi"
+            limits:
+              cpu: "250m"
+              memory: "128Mi"
+      volumes:
+        - name: caddyfile
+          configMap:
+            name: docmost-proxy-config
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: proxy
+  namespace: docmost
+spec:
+  selector:
+    app: docmost-proxy
+  ports:
+    - name: http
+      port: 80
+      targetPort: 80
+      protocol: TCP
diff --git a/deploy/k8s/50-ingress.yaml b/deploy/k8s/50-ingress.yaml
new file mode 100644
index 00000000..89523e8f
--- /dev/null
+++ b/deploy/k8s/50-ingress.yaml
@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: MIT
+#
+# Requires the ingress-nginx controller:
+#   minikube addons enable ingress
+#
+# IMPORTANT: there is deliberately NO rewrite-target annotation. The whole
+# /docmost path is passed to Caddy unchanged; stripping happens in Caddy.
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: docmost
+  namespace: docmost
+  annotations:
+    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
+    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
+    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
+spec:
+  ingressClassName: nginx
+  rules:
+    # No host restriction so http://localhost:20867 works during local tests.
+    # Add "- host: docs.example.com" for the work cluster if desired.
+    - http:
+        paths:
+          - path: /docmost
+            pathType: Exact
+            backend:
+              service:
+                name: proxy
+                port:
+                  number: 80
+          - path: /docmost/
+            pathType: Prefix
+            backend:
+              service:
+                name: proxy
+                port:
+                  number: 80
diff --git a/docker/Caddyfile b/docker/Caddyfile
new file mode 100644
index 00000000..22ed6eb9
--- /dev/null
+++ b/docker/Caddyfile
@@ -0,0 +1,51 @@
+#
+# Docmost is served under the /docmost subpath:
+#
+#   http(s)://<host>/docmost/**
+#
+# Docmost is a single app (NestJS serving the built React client), so there
+# is only ONE upstream: the whole prefix is STRIPPED and the container keeps
+# serving root paths (/api/..., /collab websocket, /assets/..., SPA routes).
+#
+# The client was built with BASE_PATH=/docmost/, so every URL it generates
+# (API calls, websocket, avatars, files, share links) already carries the
+# prefix and lands back on this proxy unchanged.
+
+# Trust reverse proxies in private networks (e.g. the nginx ingress in
+# Kubernetes) so Caddy preserves their X-Forwarded-* headers instead of
+# overwriting them with its plain-HTTP internal hop.
+{
+	servers {
+		trusted_proxies static private_ranges
+	}
+}
+
+:80
+
+log {
+	output stdout
+	level WARN
+	format console
+}
+
+# Everything under the subpath (including the bare prefix) goes to Docmost
+# with the prefix stripped. Caddy upgrades websocket connections (the
+# /collab editor websocket) automatically.
+# Do NOT set X-Forwarded-Host manually: the {host} placeholder omits the
+# port; Caddy's automatic header keeps the full host.
+@subpath path /docmost /docmost/*
+handle @subpath {
+	uri strip_prefix /docmost
+	reverse_proxy http://docmost:3000
+}
+
+# Convenience: visiting the root jumps to the subpath. NOTE: 'redir' cannot
+# be used here - its first argument is always parsed as a matcher.
+handle / {
+	header Location /docmost
+	respond 302
+}
+
+handle {
+	respond 404
+}
diff --git a/docker/docker-compose.yml b/docker/docker-compose.yml
new file mode 100644
index 00000000..7b24b05b
--- /dev/null
+++ b/docker/docker-compose.yml
@@ -0,0 +1,79 @@
+#
+# Local test setup serving Docmost under http://localhost:20867/docmost/
+#
+#   docker compose -f docker/docker-compose.yml up -d --build
+#
+# The image is built from this repository (not pulled) so that the local
+# subpath changes take effect. The client build bakes in the BASE_PATH
+# build argument. Do NOT set COLLAB_URL - the websocket is derived from
+# APP_URL and proxied through Caddy.
+---
+services:
+  docmost:
+    build:
+      context: ..
+      dockerfile: Dockerfile
+      args:
+        # Baked into the client build; change together with the prefix in
+        # the Caddyfile. Keep the trailing slash.
+        BASE_PATH: ${BASE_PATH:-/docmost/}
+    image: docmost:dev
+    restart: unless-stopped
+    environment:
+      # No trailing slash: links are concatenated on it.
+      APP_URL: ${APP_URL:-http://localhost:20867/docmost}
+      APP_SECRET: ${APP_SECRET:-local-development-app-secret-change-me-0001}
+      DATABASE_URL: postgresql://docmost:${POSTGRES_PASSWORD:-docmost}@db:5432/docmost
+      REDIS_URL: redis://redis:6379
+    volumes:
+      - docmost_storage:/app/data/storage
+    depends_on:
+      db:
+        condition: service_healthy
+      redis:
+        condition: service_healthy
+
+  db:
+    image: postgres:18
+    restart: unless-stopped
+    environment:
+      POSTGRES_DB: docmost
+      POSTGRES_USER: docmost
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-docmost}
+    volumes:
+      - docmost_db_data:/var/lib/postgresql
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U docmost -d docmost"]
+      interval: 5s
+      timeout: 5s
+      retries: 20
+
+  redis:
+    image: redis:8
+    restart: unless-stopped
+    command: ["redis-server", "--appendonly", "yes", "--maxmemory-policy", "noeviction"]
+    volumes:
+      - docmost_redis_data:/data
+    healthcheck:
+      test: ["CMD", "redis-cli", "ping"]
+      interval: 5s
+      timeout: 3s
+      retries: 20
+
+  proxy:
+    image: caddy:2
+    restart: unless-stopped
+    ports:
+      # Open http://localhost:20867/docmost/
+      - "20867:80"
+    volumes:
+      - ./Caddyfile:/etc/caddy/Caddyfile:ro
+      - caddy_data:/data
+    depends_on:
+      - docmost
+
+volumes:
+  docmost_storage:
+  docmost_db_data:
+  docmost_redis_data:
+  caddy_data:
